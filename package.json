{
  "name": "legion",
  "version": "0.2.3-h",
  "description": "A local, Claude-native multi-agent desktop bot with on-demand boat.dev VMs and a hand-painted mascot",
  "author": "dnh33",
  "license": "Apache-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "agents",
    "multi-agent",
    "mcp",
    "model-context-protocol",
    "electron",
    "boat.dev",
    "desktop",
    "local-first",
    "ai-agents"
  ],
  "homepage": "https://github.com/dnh33/legion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnh33/legion.git"
  },
  "bugs": {
    "url": "https://github.com/dnh33/legion/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/src/electron/main.js",
  "bin": {
    "legion-core": "dist/src/bin/legion-core.js",
    "legion-mcp": "dist/src/bin/legion-mcp-stdio.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "npm run build:ts && npm run build:ui",
    "build:ts": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "npm run build:ts && node --test \"dist/test/*.test.js\"",
    "core": "node dist/src/bin/legion-core.js",
    "start": "npm run build && electron .",
    "app": "electron .",
    "mcp-config": "node scripts/mcp-config.mjs",
    "dev:ui": "vite --config ui/vite.config.ts",
    "harness": "node scripts/harness/legion-harness.mjs",
    "harness:smoke": "npm run build:ts && node --test dist/test/harness-smoke.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
